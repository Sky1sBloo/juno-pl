/**
all_expr_test.juno — Juno counterpart of .cache/guide/AllExpr.xml

Layout rules:
  - Statements follow the reference program's FlightStart thread in the same
    order (AllExpr ids 0-273), then the remaining event threads (ids 274-282).
  - Vizzy's <LogMessage> maps to `do Game.localLog(<expr>);`.
  - Blocks Juno cannot express are left as a comment naming the AllExpr id.

Compile and compare (AllExpr.xml is the reference, never edited):

  ./build/juno-pl docs/sample/all_expr_test.juno /tmp/opencode/all_expr_test.xml
  diff -u .cache/guide/AllExpr.xml /tmp/opencode/all_expr_test.xml
*/
program all_expr_test;

var TestVariable;
list myList;

on start() {
    // id1 <WaitSeconds>
    do Game.delay(1);
    // id2 <WaitUntil>
    do Game.delayUntil(Fuel.stageFuel());
    // id3 <Repeat> — Vizzy <Comment> blocks are not emitted (comments are lexed away)
    repeat 10 {
        // Comment Text
    }
    // id4 <While>
    while (true) {
        // Comment Text
        break;
    }
    // id5 <DisplayMessage>
    do Game.display("text");
    // id6 <LogFlight>
    do Game.flightLog("text", true);
    // id7 <LogMessage>
    do Game.localLog("text");
    // id8-17 <If>/<ElseIf>/<Else>
    if (true) {
        do Game.localLog("text");
    } elif (false) {
        do Game.localLog("text");
        do Game.localLog("text");
    } else {
        do Game.localLog("text");
    }

    // id18-26 <BinaryOp> arithmetic
    do Game.localLog(0 + 0);
    do Game.localLog(0 - 0);
    do Game.localLog(0 / 0);
    do Game.localLog(0 * 0);
    // id22 <BinaryOp op="^"> — Juno writes it as Math.pow
    do Game.localLog(Math.pow(0, 0));
    do Game.localLog(0 % 0);
    // id24-26 op="rand"/"min"/"max" are BinaryOps in Vizzy, Math.* calls in Juno
    do Game.localLog(Math.random(0, 0));
    do Game.localLog(Math.min(0, 0));
    do Game.localLog(Math.max(0, 0));

    // id27-29 <BoolOp>/<Not>
    do Game.localLog(false and false);
    do Game.localLog(false or false);
    do Game.localLog(not false);

    // id30-34 <Comparison>
    do Game.localLog(0 == 0);
    do Game.localLog(0 < 0);
    do Game.localLog(0 <= 0);
    do Game.localLog(0 > 0);
    do Game.localLog(0 >= 0);

    // id35-36 <MathFunction> / op="atan2"
    do Game.localLog(Math.abs(0));
    do Game.localLog(Math.atan2("y", "x"));

    // id37 <Conditional>
    do Game.localLog(false ? 0 else 0);

    // id38-43 <StringOp>
    do Game.localLog(String.join("alpha", "bravo", ""));
    do Game.localLog(String.lengthOf("alpha"));
    // Vizzy letter(index, text): Juno takes (text, index)
    do Game.localLog(String.letterOf("alpha", 1));
    // Vizzy substring(start, length, text): Juno takes (text, start, length)
    do Game.localLog(String.substr("alpha", 2, 4));
    do Game.localLog(String.strContains("alpha", "a"));
    do Game.localLog(String.format("{0:n1}", "10000.99", ""));

    // id44-46 <Vector>/<VectorOp>
    do Game.localLog(Vector.vec(0, 0, 0));
    do Game.localLog(Vector.vecLength("(0, 0, 0)"));
    do Game.localLog(Vector.dot("(0, 0, 0)", "(0, 0, 0)"));
    // id47 <EvaluateExpression>
    do Game.localLog(Math.evaluate("x"));
    // id48 duplicate of id43
    do Game.localLog(String.format("{0:n1}", "10000.99", ""));

    // id49-61 <SetInput>
    do Input.throttle(0);
    do Input.roll(0);
    do Input.pitch(0);
    do Input.yaw(0);
    do Input.brake(0);
    // Vizzy has input="slider1".."slider4"; Juno names the slider by index
    do Input.slider(1, 0);
    do Input.slider(2, 0);
    do Input.slider(3, 0);
    do Input.slider(4, 0);
    do Input.translateForward(0);
    do Input.translateRight(0);
    do Input.translateUp(0);
    do Input.translationMode(0);

    // id62-65 <SetTargetHeading>
    do Craft.pitchTo(0);
    do Craft.headingTo(0);
    do Craft.pidPitchTo(0);
    do Craft.pidRollTo(0);

    // id66 <SetTarget>
    do Craft.setTarget("name");

    // id67-73 <LockNavSphere>
    do Craft.lockNone();
    do Craft.lockPrograde();
    do Craft.lockRetrograde();
    do Craft.lockTarget();
    do Craft.lockBurnNode();
    do Craft.lockCurrent();
    // Vizzy takes a single vector constant, Juno three components
    do Craft.lockVector(0, 0, 1);

    // id74-80 <SetCameraProperty>
    do Camera.zoom(100);
    do Camera.xRotation(100);
    do Camera.yRotation(100);
    do Camera.tilt(100);
    do Camera.mode(100);
    do Camera.modeIndex(100);
    do Camera.targetOffset(100);

    // id81 <SetActivationGroup>
    do Input.activationGroup(1, true);

    // id82-86 <SetCraftProperty> part control
    do Part.activate(0, 0);
    do Part.focus(0, 0);
    do Part.name(0, 0);
    // Vizzy property Part.SetExplode with two inputs
    do Part.explode(0, 0);
    // Vizzy property Part.FuelTransfer with two inputs
    do Part.drainFuel(0, 0);

    // id87 <SwitchCraft>
    do Game.switchToCraft(0);

    // id88 <PlayBeep>
    do Game.beep(1000, 1, 2);

    // id89 <LogMessage> Sound.Frequency
    do Game.localLog(Camera.soundFrequency("C#", 3));

    // id90 <Speak>
    do Game.speak("text", 0, 0);

    // id91-93 Altitude
    do Game.localLog(Altitude.getAGL());
    do Game.localLog(Altitude.getASL());
    do Game.localLog(Altitude.getASF());
    // id94-100 Orbit
    do Game.localLog(Orbit.ap());
    do Game.localLog(Orbit.pe());
    do Game.localLog(Orbit.timeToAp());
    do Game.localLog(Orbit.timeToPe());
    do Game.localLog(Orbit.eccentricity());
    do Game.localLog(Orbit.inclination());
    do Game.localLog(Orbit.period());
    // id101-106 Atmosphere
    do Game.localLog(Atmosphere.density());
    do Game.localLog(Atmosphere.pressure());
    do Game.localLog(Atmosphere.speedOfSound());
    do Game.localLog(Atmosphere.temperature());
    do Game.localLog(Atmosphere.elements());
    do Game.localLog(Atmosphere.composition());
    // id107-115 Performance
    do Game.localLog(Performance.mass());
    do Game.localLog(Performance.engineThrust());
    do Game.localLog(Performance.dryMass());
    do Game.localLog(Performance.fuelMass());
    do Game.localLog(Performance.maxEngineThrust());
    do Game.localLog(Performance.twr());
    do Game.localLog(Performance.currentISP());
    do Game.localLog(Performance.stageDeltaV());
    do Game.localLog(Performance.stageBurnTime());
    // id116-119 Fuel
    do Game.localLog(Fuel.battery());
    do Game.localLog(Fuel.stageFuel());
    do Game.localLog(Fuel.monoProp());
    do Game.localLog(Fuel.totalFuel());
    // id120-133 Nav
    do Game.localLog(Nav.position());
    do Game.localLog(Nav.target());
    do Game.localLog(Nav.heading());
    do Game.localLog(Nav.pitch());
    do Game.localLog(Nav.autopilotHeading());
    do Game.localLog(Nav.autopilotPitch());
    do Game.localLog(Nav.bankAngle());
    do Game.localLog(Nav.angleOfAttack());
    do Game.localLog(Nav.sideSlip());
    do Game.localLog(Nav.northVector());
    do Game.localLog(Nav.eastVector());
    do Game.localLog(Nav.craftDirection());
    do Game.localLog(Nav.craftRight());
    do Game.localLog(Nav.craftUp());
    // id134-142 Velocity
    do Game.localLog(Velocity.orbit());
    do Game.localLog(Velocity.surface());
    do Game.localLog(Velocity.target());
    do Game.localLog(Velocity.gravity());
    do Game.localLog(Velocity.acceleration());
    do Game.localLog(Velocity.angular());
    do Game.localLog(Velocity.lateral());
    do Game.localLog(Velocity.vertical());
    do Game.localLog(Velocity.mach());
    // id143-155 Input
    do Game.localLog(Input.roll());
    do Game.localLog(Input.pitch());
    do Game.localLog(Input.yaw());
    do Game.localLog(Input.throttle());
    do Game.localLog(Input.brake());
    do Game.localLog(Input.slider(1));
    do Game.localLog(Input.slider2());
    do Game.localLog(Input.slider3());
    do Game.localLog(Input.slider4());
    do Game.localLog(Input.translateForward());
    do Game.localLog(Input.translateRight());
    do Game.localLog(Input.translateUp());
    do Game.localLog(Input.translationMode());
    // id156-164 Misc
    do Game.localLog(Misc.grounded());
    do Game.localLog(Misc.stage());
    do Game.localLog(Misc.numStages());
    do Game.localLog(Misc.solarRadiation());
    do Game.localLog(Misc.cameraPosition());
    do Game.localLog(Misc.cameraPointing());
    do Game.localLog(Misc.cameraUp());
    do Game.localLog(Misc.pidPitch());
    do Game.localLog(Misc.pidRoll());
    // id165-169 Time
    do Game.localLog(Time.sinceLaunch());
    do Game.localLog(Time.delta());
    do Game.localLog(Time.total());
    do Game.localLog(Time.warpAmount());
    do Game.localLog(Time.realTime());
    // id170-173 names
    do Game.localLog(Craft.name());
    do Game.localLog(Orbit.planetName());
    do Game.localLog(Target.name());
    do Game.localLog(Target.planet());

    // id174 <ActivationGroup>
    do Game.localLog(Input.activationGroup(1));

    // id175-178 planet conversions — <Planet op="toLatLongAgl" ...> in Vizzy
    do Game.localLog(Nav.toLatLongAGL("(0, 0, 0)"));
    do Game.localLog(Nav.toLatLongASL("(0, 0, 0)"));
    do Game.localLog(Nav.toPosition("(0, 0, 0)"));
    do Game.localLog(Nav.toPositionOverSea("(0, 0, 0)"));

    // id179-181 terrain / raycast
    do Game.localLog(Terrain.height("(0, 0, 0)"));
    do Game.localLog(Terrain.color("(0, 0, 0)"));
    do Game.localLog(Raycast.raycast("(0, 0, 0)", "(0, 0, 0)"));

    // id182-215 <Planet>
    do Game.localLog(Planet.radius("Droo"));
    do Game.localLog(Planet.mass("Droo"));
    do Game.localLog(Planet.hasTerrain("Droo"));
    do Game.localLog(Planet.atmosphereDensity("Droo"));
    do Game.localLog(Planet.atmosphereHeight("Droo"));
    do Game.localLog(Planet.atmosphereScale("Droo"));
    do Game.localLog(Planet.atmosphereElements("Droo"));
    do Game.localLog(Planet.atmosphereComposition("Droo"));
    do Game.localLog(Planet.hydrosphereElement("Droo"));
    do Game.localLog(Planet.hydrosphereDensity("Droo"));
    do Game.localLog(Planet.soiradius("Droo"));
    do Game.localLog(Planet.solarPosition("Droo"));
    do Game.localLog(Planet.childPlanets("Droo"));
    do Game.localLog(Planet.crafts("Droo"));
    // Vizzy op="craftids"
    do Game.localLog(Planet.craftID("Droo"));
    do Game.localLog(Planet.parent("Droo"));
    do Game.localLog(Planet.structures("Droo"));
    do Game.localLog(Planet.day("Droo"));
    do Game.localLog(Planet.year("Droo"));
    do Game.localLog(Planet.velocity("Droo"));
    do Game.localLog(Planet.apoapsis("Droo"));
    do Game.localLog(Planet.periapsis("Droo"));
    do Game.localLog(Planet.period("Droo"));
    // Vizzy ops apoapsistime/periapsistime
    do Game.localLog(Planet.orbitApTime("Droo"));
    do Game.localLog(Planet.orbitPeTime("Droo"));
    do Game.localLog(Planet.inclination("Droo"));
    do Game.localLog(Planet.eccentricity("Droo"));
    do Game.localLog(Planet.meananomaly("Droo"));
    do Game.localLog(Planet.meanmotion("Droo"));
    // Vizzy ops periapsisargument/rightascension/trueanomaly/semimajoraxis/semiminoraxis
    do Game.localLog(Planet.orbitPeriapsisArgument("Droo"));
    do Game.localLog(Planet.orbitRightAscension("Droo"));
    do Game.localLog(Planet.orbitTrueAnomaly("Droo"));
    do Game.localLog(Planet.orbitSemiMajorAxis("Droo"));
    do Game.localLog(Planet.orbitSemiMinorAxis("Droo"));

    // id216-231 <Part>
    do Game.localLog(Part.idToName(0));
    do Game.localLog(Part.mass(0));
    do Game.localLog(Part.dryMass(0));
    do Game.localLog(Part.wetMass(0));
    do Game.localLog(Part.activated(0));
    do Game.localLog(Part.partType(0));
    do Game.localLog(Part.position(0));
    do Game.localLog(Part.temperature(0));
    do Game.localLog(Part.drag(0));
    do Game.localLog(Part.thisID(0));
    do Game.localLog(Part.minPartId(0));
    do Game.localLog(Part.maxPartId(0));
    do Game.localLog(Part.underwater(0));
    do Game.localLog(Part.nameToID("PartName"));
    do Game.localLog(Part.localToPCI(0, "(0, 0, 0)"));
    do Game.localLog(Part.pciToLocal(0, "(0, 0, 0)"));

    // id232-258 <Craft>
    do Game.localLog(Craft.altitude(0));
    do Game.localLog(Craft.isDestroyed(0));
    do Game.localLog(Craft.isGrounded(0));
    do Game.localLog(Craft.mass(0));
    // Vizzy reads <CraftProperty property="Craft.IDToName"> from a number
    do Game.localLog(Craft.name(0));
    do Game.localLog(Craft.partCount(0));
    do Game.localLog(Craft.planet(0));
    do Game.localLog(Craft.position(0));
    do Game.localLog(Craft.velocity(0));
    do Game.localLog(Craft.isPlayer(0));
    do Game.localLog(Craft.boundingBoxMin(0));
    do Game.localLog(Craft.boundingBoxMax(0));
    do Game.localLog(Craft.ap(0));
    do Game.localLog(Craft.pe(0));
    do Game.localLog(Craft.period(0));
    do Game.localLog(Craft.apoapsisTime(0));
    do Game.localLog(Craft.periapsisTime(0));
    do Game.localLog(Craft.inclination(0));
    do Game.localLog(Craft.eccentricity(0));
    do Game.localLog(Craft.meanAnomaly(0));
    do Game.localLog(Craft.meanMotion(0));
    do Game.localLog(Craft.periapsisArgument(0));
    do Game.localLog(Craft.rightAscension(0));
    do Game.localLog(Craft.trueAnomaly(0));
    do Game.localLog(Craft.semiMajorAxis(0));
    do Game.localLog(Craft.semiMinorAxis(0));
    do Game.localLog(Craft.nameToID("CraftName"));

    // id259-260 boolean constants
    do Game.localLog(true);
    do Game.localLog(false);

    // id261-267 <SetList>
    do Lists.add(myList, "item");
    do Lists.insert(myList, "item", 1);
    do Lists.remove(myList, 1);
    // Vizzy set order is (list, value, index); Juno's is (list, index, value)
    do Lists.set(myList, 1, "item");
    do Lists.clear(myList);
    do Lists.sort(myList);
    do Lists.reverse(myList);

    // id268 <SetVariable style="list-init">
    list items = ["a", "b", "c"];

    // id269-271 <ListOp>
    do Game.localLog(items[0]);
    do Game.localLog(ListOp.length(items));
    do Game.localLog(ListOp.index(items, "item"));

    // id272-273 <LogMessage>
    do Game.localLog("");
    do Game.localLog("");
}

// id274-277 <ReceiveMessage> + <BroadcastMessage>
on CustomEvent() {
    emit event() to script;
    emit ev() to craft;
    emit ev() to nearby;
}

// id278 <PartCollision>
on collision() {
}

// id279 second <FlightStart> — Juno accepts more than one start handler
on start() {
}

// id280 <PartExplode>
on explode() {
}

// id281 <Docked>
on dock() {
}

// id282 <ChangeSoi>
on enterSOI() {
}
